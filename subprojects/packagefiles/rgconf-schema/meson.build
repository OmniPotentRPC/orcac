# Overlay for the rgconf source archive. Only the Cap'n Proto schema files
# are used; rgconf's own build (cargo) is never run.
project('rgconf-schema', version: 'b6643e8')

potential_capnp_file = meson.current_source_dir() / 'crates/rgconf-core/schema/potential.capnp'
common_capnp_file = meson.current_source_dir() / 'crates/rgconf-core/schema/common.capnp'
